{
  "name": "@bgt/overlay",
  "version": "0.9.1",
  "private": true,
  "license": "MIT",
  "description": "Overlay en jeu de BG Tracker (Electron). Non affilié à Blizzard Entertainment.",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc --noEmit -p . && node build.mjs && vite build",
    "start": "electron .",
    "replay": "electron . --replay",
    "demo": "node build.mjs --demo-only && vite --open",
    "package": "node package.mjs",
    "package:dir": "node package.mjs --dir"
  },
  "dependencies": {
    "@bgt/core": "workspace:*",
    "@bgt/data": "workspace:*",
    "@bgt/history": "workspace:*",
    "@bgt/season-s14": "workspace:*",
    "@bgt/sim": "workspace:*",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "electron-updater": "6.8.10",
    "koffi": "3.3.3",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  }
}
