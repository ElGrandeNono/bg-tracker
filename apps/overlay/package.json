{
  "name": "@bgt/overlay",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Overlay en jeu de BG Tracker (Electron). Non affilié à Blizzard Entertainment.",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc --noEmit -p . && node build.mjs && vite build",
    "start": "electron .",
    "replay": "electron . --replay",
    "demo": "node build.mjs --demo-only && vite --open"
  },
  "dependencies": {
    "@bgt/core": "workspace:*",
    "@bgt/data": "workspace:*",
    "koffi": "3.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  }
}
