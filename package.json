{
  "name": "bg-tracker",
  "private": true,
  "version": "0.0.0",
  "description": "Tracker Hearthstone Battlegrounds basé sur Power.log. Non affilié à Blizzard Entertainment.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @bgt/overlay build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "tsc -b --clean",
    "replay": "tsc -b && node packages/core/dist/cli/replay.js",
    "overlay": "pnpm --filter @bgt/overlay build && pnpm --filter @bgt/overlay start",
    "overlay:replay": "pnpm --filter @bgt/overlay build && pnpm --filter @bgt/overlay exec electron . --replay",
    "overlay:demo": "pnpm --filter @bgt/overlay demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
